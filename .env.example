PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lifeadmin
# SQLite fallback support for seamless local instant running if Postgres is offline
USE_SQLITE_FALLBACK=true

# Authentication
JWT_SECRET=super_secret_jwt_key_lifeadmin_production_security_2026!
JWT_EXPIRES_IN=7d

# File Storage
UPLOAD_DIR=../uploads
MAX_FILE_SIZE=10485760 # 10MB in bytes

# AI & OCR
AI_PROVIDER=gemini # options: gemini, mock
GEMINI_API_KEY=
OCR_ENGINE=tesseract # options: tesseract, mock
