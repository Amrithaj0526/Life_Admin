PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Database Configuration (PostgreSQL primary; SQLite fallback enabled by default for zero-config local run)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lifeadmin
USE_SQLITE_FALLBACK=true

# Authentication & Security
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
TOKEN_ENCRYPTION_KEY=replace_with_32_byte_hex_or_random_encryption_key

# File Storage
UPLOAD_DIR=../uploads
MAX_FILE_SIZE=10485760 # 10MB in bytes

# AI Intelligence & OCR Engines
AI_PROVIDER=gemini # options: gemini, mock
GEMINI_API_KEY=
OCR_ENGINE=tesseract # options: tesseract, mock

# Google Cloud OAuth (for Calendar Synchronization)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/google/callback
